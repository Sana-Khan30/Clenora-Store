# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit ".env" to Git. This example file contains no secrets.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Include a database name, e.g. ...mongodb.net/cleany?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Exact origin(s) of the React site, no trailing slash. Comma-separate for several.
# Development: http://localhost:5173   Production: https://your-client-domain.com
CLIENT_URL=http://localhost:5173

# Cloudinary (needed from Phase 4): Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used ONLY by the admin creation script (Phase 3). Set them, run the script once,
# then delete these three lines from your .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPTIONAL, for running the database tests (npm test). Use the SAME Atlas connection string
# but with a DIFFERENT database name that ends in _test (e.g. .../cleany_test?retryWrites=...).
# Tests wipe this database, so it must never be your real one. Leave empty to skip those tests.
TEST_MONGODB_URI=
